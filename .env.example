# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub (it's already in .gitignore).

# --- Email (sender) settings ---
# For Gmail: enable 2FA on the account, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use that here
# (NOT your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# --- Email (recipient) ---
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com

# --- Behaviour ---
# Comma-separated list of site keys to scrape (must match config/sites.yaml)
SITES=infineon,basf,statista,zeiss

# Only email jobs whose title/location matches these keywords (comma-separated).
# Leave empty to receive every new job found.
KEYWORD_FILTER=

# Send an email even if zero new jobs were found (useful for confirming the
# job is still running). true / false
SEND_EMPTY_DIGEST=false
